# Copy to .env.local. Never commit real values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
HOST=127.0.0.1
PORT=4317
# Required when HOST=0.0.0.0. Example: https://your-domain.example
PUBLIC_ORIGIN=
# Generate a random code >=20 characters; share privately with invited users.
APP_ACCESS_TOKEN=
MAX_REQUESTS_PER_HOUR=30
